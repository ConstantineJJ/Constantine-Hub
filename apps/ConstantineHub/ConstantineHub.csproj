<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ConstantineHub</RootNamespace>
    <AssemblyName>ConstantineHub</AssemblyName>
    <Version>0.1.5</Version>
    <AssemblyVersion>0.1.5.0</AssemblyVersion>
    <FileVersion>0.1.5.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('Assets\CH_Icon.ico')">
    <ApplicationIcon>Assets\CH_Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="Exists('Assets\CH_Icon.ico')">
    <None Update="Assets\CH_Icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>CH_Icon.ico</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\adapters\godot-mcp')">
    <Content Include="..\..\adapters\godot-mcp\**\*"
             Exclude="..\..\adapters\godot-mcp\.venv\**\*;..\..\adapters\godot-mcp\**\__pycache__\**\*;..\..\adapters\godot-mcp\**\*.pyc"
             Link="adapters\godot-mcp\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
