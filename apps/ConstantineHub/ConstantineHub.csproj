<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ConstantineHub</RootNamespace>
    <AssemblyName>ConstantineHub</AssemblyName>
    <Version>0.2.5</Version>
    <AssemblyVersion>0.2.5.0</AssemblyVersion>
    <FileVersion>0.2.5.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ConstantineHub.SmokeTests" />
  </ItemGroup>

  <PropertyGroup Condition="Exists('Assets\CH_Icon.ico')">
    <ApplicationIcon>Assets\CH_Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\CH_Icon.ico" Condition="Exists('Assets\CH_Icon.ico')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>CH_Icon.ico</TargetPath>
    </None>
    <None Update="Assets\WatermelonCat.png" Condition="Exists('Assets\WatermelonCat.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>WatermelonCat.png</TargetPath>
    </None>
    <None Update="Assets\WatermelonCatWaving.png" Condition="Exists('Assets\WatermelonCatWaving.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>WatermelonCatWaving.png</TargetPath>
    </None>
    <None Update="Assets\LocalFilesIcon.png" Condition="Exists('Assets\LocalFilesIcon.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>LocalFilesIcon.png</TargetPath>
    </None>
    <None Update="Assets\BlenderIcon.png" Condition="Exists('Assets\BlenderIcon.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>BlenderIcon.png</TargetPath>
    </None>
    <None Update="Assets\GodotIcon.png" Condition="Exists('Assets\GodotIcon.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>GodotIcon.png</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\adapters\godot-mcp')">
    <Content Include="..\..\adapters\godot-mcp\**\*"
             Exclude="..\..\adapters\godot-mcp\.venv\**\*;..\..\adapters\godot-mcp\**\__pycache__\**\*;..\..\adapters\godot-mcp\**\*.pyc"
             Link="adapters\godot-mcp\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
